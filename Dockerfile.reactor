# AFI Reactor — scoring pipeline server (Express).  Deploy target: Cloud Run.
#
# IMPORTANT: build context = AFI-Protocol workspace ROOT, not afi-reactor/.
#   afi-reactor depends on `file:../afi-config` and `file:../afi-core`, so those
#   sibling dirs must be present in the build context and built FIRST (their
#   `prepare` scripts do NOT run for file: deps, and we pass --ignore-scripts to
#   avoid husky failing in a non-git container).  afi-infra / afi-math are public
#   git+https deps pulled at `npm ci` time (needs git + network, no creds).
#
# Build from the workspace root, e.g.:
#   gcloud builds submit --tag <IMG> -f afi-reactor/Dockerfile.reactor .
FROM node:20 AS build
WORKDIR /workspace

# Only the three repos the reactor build needs.
COPY afi-config/ ./afi-config/
COPY afi-core/   ./afi-core/
COPY afi-reactor/ ./afi-reactor/

# Build order config -> core -> reactor.  --ignore-scripts skips husky (no .git
# here) and the file:-dep prepare; we invoke each build explicitly.
RUN cd /workspace/afi-config  && npm ci --ignore-scripts && npm run build \
 && cd /workspace/afi-core    && npm ci --ignore-scripts && npm run build \
 && cd /workspace/afi-reactor && npm ci --ignore-scripts && npm run build \
 && npm prune --omit=dev

FROM node:20-slim
WORKDIR /workspace/afi-reactor
ENV NODE_ENV=production
# Carry the whole workspace so the file: links (afi-config/afi-core dist) and the
# reactor's pruned prod node_modules resolve unchanged.
COPY --from=build /workspace /workspace
# server.ts honors Cloud Run's $PORT (falls back to AFI_REACTOR_PORT/8080).
CMD ["node", "dist/src/server.js"]
